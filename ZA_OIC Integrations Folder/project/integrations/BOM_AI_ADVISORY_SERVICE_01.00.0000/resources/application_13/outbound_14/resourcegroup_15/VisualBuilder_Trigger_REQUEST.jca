<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/VisualBuilder_Trigger_REQUEST/types" name="VisualBuilder_Trigger_REQUESTPortType" adapter="REST" wsdlLocation="VisualBuilder_Trigger_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.rest.RestAdapterConnectionFactory">
      <property name="cloud.adapter.plugin.init.version" value="25.06.0"/>
      <property name="cloud.adapter.plugin.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.init.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.version" value="25.06.0"/>
      <property name="connectionUrl" value="%%ORDS_ATP_REST_CONN_connectionUrl"/>
      <property name="privateEndpoint" value="false"/>
      <property name="securityPolicy" value="NONE"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-activation portType="VisualBuilder_Trigger_REQUESTPortType" operation="execute">
    <activation-spec className="oracle.tip.adapter.cloud.CloudActivationSpec">
      <property name="targetOperation" value="execute"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="POST"/>
      <property name="RequestElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/VisualBuilder_Trigger/types"/>
      <property name="RequestElementName" value="request-wrapper"/>
      <property name="RequestMediaType" value="application/json"/>
      <property name="RequestSample" value="{   &quot;bom_id&quot;: &quot;1&quot;,   &quot;requested_by&quot;: &quot;VBCS_USER&quot; }"/>
      <property name="ResourceURI" value="/generate-advisory"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/VisualBuilder_Trigger/types"/>
      <property name="ResponseElementName" value="response-wrapper"/>
      <property name="ResponseMediaType" value="application/json"/>
      <property name="ResponseSample" value="{   &quot;status&quot;: &quot;SUCCESS&quot;,   &quot;bom_id&quot;: &quot;1&quot;,   &quot;ai_summary&quot;: &quot;Text summary&quot;,   &quot;ai_suggested_action&quot;: &quot;Text action&quot; }"/>
      <property name="allowChangeDefaultNamespace" value="false"/>
      <property name="copyFaultFromModel" value="true"/>
      <property name="generateConnectivityPropertiesInboundRequest" value="RESTINREQ"/>
      <property name="generateConnectivityPropertiesInboundResponse" value="RESTINRES"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="generateSecurityPropertiesInboundRequest" value="SECURITYPROPSRESTINREQ"/>
      <property name="integrationSchemaNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/VisualBuilder_Trigger_REQUEST/types"/>
      <property name="integrationWSDLNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/VisualBuilder_Trigger_REQUEST"/>
      <property name="invocationStyle" value="REQUEST_RESPONSE"/>
      <property name="isRequestJsonSchema" value="false"/>
      <property name="isRequestRawBytes" value="false"/>
      <property name="isResponseJsonSchema" value="false"/>
      <property name="isResponseRawBytes" value="false"/>
      <property name="operations" value="default"/>
      <property name="postQueryParamsAsContent" value="false"/>
      <property name="requestJsonTopLevelArray" value="false"/>
      <property name="responseJsonTopLevelArray" value="false"/>
    </activation-spec>
  </endpoint-activation>
</adapter-config>