<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/Invoke_Gemini_API_REQUEST/types" name="Invoke_Gemini_API_REQUESTPortType" adapter="REST" wsdlLocation="Invoke_Gemini_API_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.rest.RestAdapterConnectionFactory">
      <property name="cloud.adapter.plugin.init.version" value="25.06.0"/>
      <property name="cloud.adapter.plugin.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.init.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.version" value="25.06.0"/>
      <property name="connectionUrl" value="%%GEMINI_AI_REST_CONN_connectionUrl"/>
      <property name="privateEndpoint" value="false"/>
      <property name="securityPolicy" value="NONE"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-interaction portType="Invoke_Gemini_API_REQUESTPortType" operation="execute">
    <interaction-spec className="oracle.tip.adapter.cloud.CloudInteractionSpec">
      <property name="targetOperation" value="execute"/>
      <property name="enforceResponseSizeRestriction" value="true"/>
      <property name="oic.gen3.invoke" value="true"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="POST"/>
      <property name="QueryParameters" value="key"/>
      <property name="RequestElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/Invoke_Gemini_API/types"/>
      <property name="RequestElementName" value="request-wrapper"/>
      <property name="RequestMediaType" value="application/json"/>
      <property name="RequestSample" value="{   &quot;contents&quot; : [ {     &quot;parts&quot; : [ {       &quot;text&quot; : &quot;Prompt text&quot;     } ]   } ] }"/>
      <property name="ResourceURI" value="/v1beta/models/gemini-flash-latest:generateContent"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/Invoke_Gemini_API/types"/>
      <property name="ResponseElementName" value="response-wrapper"/>
      <property name="ResponseMediaType" value="application/json"/>
      <property name="ResponseSample" value="{   &quot;candidates&quot;: [     {       &quot;content&quot;: {         &quot;parts&quot;: [           {             &quot;text&quot;: &quot;AI generated output string&quot;           }         ]       }     }   ] }"/>
      <property name="abstractComplexType" value="true"/>
      <property name="allowChangeDefaultNamespace" value="false"/>
      <property name="copyDescendantTypes" value="true"/>
      <property name="copyDescendantTypesFullTraverse" value="true"/>
      <property name="copyFaultFromModel" value="true"/>
      <property name="dynamicConnectionEnabled" value="false"/>
      <property name="generateConnectivityPropertiesOutboundRequest" value="RESTOUTREQ"/>
      <property name="generateConnectivityPropertiesOutboundResponse" value="RESTOUTRES"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="generateSecurityPropertiesOutboundRequest" value="SECURITYPROPSRESTOUTREQ"/>
      <property name="integrationSchemaNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/Invoke_Gemini_API_REQUEST/types"/>
      <property name="integrationWSDLNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/Invoke_Gemini_API_REQUEST"/>
      <property name="invocationStyle" value="REQUEST_RESPONSE"/>
      <property name="isRequestJsonSchema" value="false"/>
      <property name="isRequestRawBytes" value="false"/>
      <property name="isResponseJsonSchema" value="false"/>
      <property name="isResponseRawBytes" value="false"/>
      <property name="postQueryParamsAsContent" value="false"/>
      <property name="requestJsonTopLevelArray" value="false"/>
      <property name="responseJsonTopLevelArray" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
</adapter-config>