<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/Get_BOM_Findings_REQUEST/types" name="Get_BOM_Findings_REQUESTPortType" adapter="REST" wsdlLocation="Get_BOM_Findings_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
