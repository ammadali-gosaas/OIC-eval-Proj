<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/Receive_Finding_Request_REQUEST/types" name="Receive_Finding_Request_REQUESTPortType" adapter="REST" wsdlLocation="Receive_Finding_Request_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.rest.RestAdapterConnectionFactory">
      <property name="cloud.adapter.plugin.init.version" value="25.06.0"/>
      <property name="cloud.adapter.plugin.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.init.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.version" value="25.06.0"/>
      <property name="privateEndpoint" value="false"/>
      <property name="rest.inbound.security.configurable" value="true"/>
      <property name="security" value="oracle/wss_http_token_service_policy"/>
      <property name="securityPolicy" value="BASIC_AUTH"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-activation portType="Receive_Finding_Request_REQUESTPortType" operation="execute">
    <activation-spec className="oracle.tip.adapter.cloud.CloudActivationSpec">
      <property name="targetOperation" value="execute"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="GET"/>
      <property name="QueryParameters" value="finding_id"/>
      <property name="ResourceURI" value="/finding-advisory"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/Receive_Finding_Request/types"/>
      <property name="ResponseElementName" value="response-wrapper"/>
      <property name="ResponseMediaType" value="application/json"/>
      <property name="ResponseSample" value="{   &quot;status&quot;: &quot;Success&quot;,   &quot;message&quot;: &quot;AI Advisory generated and saved to the database.&quot; }"/>
      <property name="allowChangeDefaultNamespace" value="false"/>
      <property name="copyFaultFromModel" value="true"/>
      <property name="generateConnectivityPropertiesInboundRequest" value="RESTINREQ"/>
      <property name="generateConnectivityPropertiesInboundResponse" value="RESTINRES"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="generateSecurityPropertiesInboundRequest" value="SECURITYPROPSRESTINREQ"/>
      <property name="integrationSchemaNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/Receive_Finding_Request_REQUEST/types"/>
      <property name="integrationWSDLNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/Receive_Finding_Request_REQUEST"/>
      <property name="invocationStyle" value="REQUEST_RESPONSE"/>
      <property name="isResponseJsonSchema" value="false"/>
      <property name="isResponseRawBytes" value="false"/>
      <property name="operations" value="default"/>
      <property name="postQueryParamsAsContent" value="false"/>
      <property name="responseJsonTopLevelArray" value="false"/>
    </activation-spec>
  </endpoint-activation>
</adapter-config>