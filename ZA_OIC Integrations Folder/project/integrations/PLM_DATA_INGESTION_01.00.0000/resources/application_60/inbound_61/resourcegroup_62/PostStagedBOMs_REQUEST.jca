<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/PostStagedBOMs_REQUEST/types" name="PostStagedBOMs_REQUESTPortType" adapter="REST" wsdlLocation="PostStagedBOMs_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
