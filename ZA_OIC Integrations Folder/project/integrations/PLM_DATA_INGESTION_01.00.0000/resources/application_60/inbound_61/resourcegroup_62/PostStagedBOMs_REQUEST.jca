      <property name="RequestSample" value="{   &quot;items&quot; : [ {     &quot;bom_level&quot; : 1,     &quot;assembly_item_number&quot; : &quot;GS-CAP-01&quot;,     &quot;bill_sequence_id&quot; : 300000326909123,     &quot;organization_code&quot; : &quot;GOSAAS&quot;,     &quot;structure_name&quot; : &quot;Primary&quot;,     &quot;bom_description&quot; : &quot;Test Capacitor 1&quot;,     &quot;component_item_number&quot; : &quot;GS-CAP-02&quot;,     &quot;quantity&quot; : 1,     &quot;uom_code&quot; : &quot;EA&quot;,     &quot;effectivity_start&quot; : &quot;2024-04-16T00:00:00Z&quot;,     &quot;effectivity_end&quot; : &quot;&quot;,     &quot;operation_seq_num&quot; : 1,     &quot;item_class&quot; : &quot;Electrical&quot;,     &quot;item_status&quot; : &quot;Active&quot;,     &quot;component_sequence_id&quot; : &quot;300000326909124&quot;,     &quot;item_sequence_number&quot; : 10,     &quot;component_path&quot; : &quot;GS-CAP-01/GS-CAP-02&quot;   } ] }"/>
      <property name="ResourceURI" value="/boms"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/PostStagedBOMs/types"/>
      <property name="ResponseElementName" value="response-wrapper"/>
      <property name="ResponseMediaType" value="application/json"/>
