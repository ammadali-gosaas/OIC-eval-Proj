{
  "title": "BOM Detail",
  "description": "Dynamic BOM Detail Page — fetches live data from BOMValidation API",
  "variables": {
    "bomId": {
      "type": "string",
      "input": "fromCaller",
      "defaultValue": ""
    },
    "selectedTab": {
      "type": "string",
      "defaultValue": "Overview"
    },
    "bomData": {
      "type": "any",
      "defaultValue": {
        "bomId": "",
        "billSequenceId": "",
        "orgCode": "",
        "itemNumber": "Loading…",
        "structureName": "",
        "description": "",
        "effectivityControl": "",
        "sourceUpdatedAt": "",
        "importBatchId": "",
        "importedAt": "",
        "healthScore": 100
      }
    },
    "filterStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "filterSeverity": {
      "type": "string",
      "defaultValue": ""
    },
    "findingsSdp": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "BOMValidation/listFindings",
        "keyAttributes": "finding_id",
        "itemsPath": "items",
        "uriParameters": {
          "bom_id": "{{ $variables.bomId }}",
          "issue_status": "{{ $variables.filterStatus }}",
          "severity": "{{ $variables.filterSeverity }}"
        }
      },
      "events": {
        "onResponse": "HandleItemsSourceChain"
      }
    },
    "hasNoFindings": {
      "type": "boolean",
      "defaultValue": false
    },
    "selectedFindingId": {
      "type": "string"
    },
    "runHistoryList": {
      "type": "any",
      "defaultValue": []
    },
    "scoreDeductionsList": {
      "type": "any",
      "defaultValue": []
    },
    "componentsList": {
      "type": "any",
      "defaultValue": []
    },
    "auditTrailList": {
      "type": "any",
      "defaultValue": []
    },
    "advisoryStatus": {
      "type": "string",
      "defaultValue": "NOT_REQUESTED"
    },
    "advisoryText": {
      "type": "string",
      "defaultValue": ""
    },
    "advisoryMitigation": {
      "type": "string",
      "defaultValue": ""
    },
    "findingAdvisoryStatus": {
      "type": "string",
      "defaultValue": "NOT_REQUESTED"
    },
    "findingAdvisoryText": {
      "type": "string",
      "defaultValue": ""
    },
    "findingAdvisoryMitigation": {
      "type": "string",
      "defaultValue": ""
    },
    "advisoryRequestId": {
      "type": "string",
      "defaultValue": ""
    },
    "isRefreshing": {
      "type": "boolean",
      "defaultValue": false
    },
    "isValidating": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "metadata": {},
  "types": {},
  "chains": {
    "LoadStylesChain": {
      "root": "callFunctionLoadTailwind",
      "actions": {
        "callFunctionLoadTailwind": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "loadTailwind"
          }
        }
      }
    },
    "loadBomDetailChain": {
      "description": "Fetch BOM header data from BOMValidation/getBomDetail using bomId",
      "variables": {
        "bomId": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "callGetBomDetail",
      "actions": {
        "callGetBomDetail": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/getBomDetail",
            "uriParams": {
              "bom_id": "{{ $page.variables.bomId }}"
            }
          },
          "outcomes": {
            "success": "parseBomDetail",
            "failure": "fireLoadError"
          }
        },
        "parseBomDetail": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseBomDetailResponse",
            "params": [
              "{{ $chain.results.callGetBomDetail.body }}"
            ]
          },
          "outcomes": {
            "success": "assignBomData"
          }
        },
        "assignBomData": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.bomData": {
              "source": "{{ $chain.results.parseBomDetail }}",
              "auto": "always"
            }
          },
          "outcomes": {
            "success": "parseComponents"
          }
        },
        "parseComponents": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseComponentsResponse",
            "params": [
              "{{ $chain.results.callGetBomDetail.body }}"
            ]
          },
          "outcomes": {
            "success": "assignComponents"
          }
        },
        "assignComponents": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.componentsList": {
              "source": "{{ $chain.results.parseComponents }}",
              "auto": "always"
            }
          },
          "outcomes": {
            "success": "parseScoreDeductions"
          }
        },
        "parseScoreDeductions": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseScoreDeductions",
            "params": [
              "{{ $chain.results.callGetBomDetail.body }}"
            ]
          },
          "outcomes": {
            "success": "assignScoreDeductions"
          }
        },
        "assignScoreDeductions": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.scoreDeductionsList": {
              "source": "{{ $chain.results.parseScoreDeductions }}",
              "auto": "always"
            }
          },
          "outcomes": {
            "success": "parseAuditTrail"
          }
        },
        "parseAuditTrail": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseAuditTrail",
            "params": [
              "{{ $chain.results.callGetBomDetail.body }}"
            ]
          },
          "outcomes": {
            "success": "assignAuditTrailVar"
          }
        },
        "assignAuditTrailVar": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.auditTrailList": {
              "source": "{{ $chain.results.parseAuditTrail }}",
              "auto": "always"
            }
          },
          "outcomes": {
            "success": "loadBomRuns"
          }
        },
        "loadBomRuns": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/listBomRuns",
            "uriParams": {
              "bom_id": "{{ $page.variables.bomId }}"
            }
          },
          "outcomes": {
            "success": "assignRunHistory",
            "failure": "callGetAdvisoriesList"
          }
        },
        "assignRunHistory": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseRunsResponse",
            "params": [
              "{{ $chain.results.loadBomRuns.body }}"
            ]
          },
          "outcomes": {
            "success": "assignRunHistoryVar"
          }
        },
        "assignRunHistoryVar": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.runHistoryList": {
              "source": "{{ $chain.results.assignRunHistory }}",
              "auto": "always"
            }
          },
          "outcomes": {
            "success": "callGetAdvisoriesList"
          }
        },
        "fireLoadError": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Failed to load BOM detail. Please check your connection.",
            "type": "error",
            "displayMode": "persist"
          }
        },
        "callGetAdvisoriesList": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/getBomsBomIdAdvisories",
            "uriParams": {
              "bom_id": "{{ $page.variables.bomId }}"
            }
          },
          "outcomes": {
            "success": "parseAdvisoriesList"
          }
        },
        "parseAdvisoriesList": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseLatestBomAdvisory",
            "params": [
              "{{ $chain.results.callGetAdvisoriesList.body }}"
            ]
          },
          "outcomes": {
            "success": "assignLatestAdvisory"
          }
        },
        "assignLatestAdvisory": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "{{ $chain.results.parseAdvisoriesList.status }}",
              "auto": "always"
            },
            "$page.variables.advisoryText": {
              "source": "{{ $chain.results.parseAdvisoriesList.context }}",
              "auto": "always"
            },
            "$page.variables.advisoryMitigation": {
              "source": "{{ $chain.results.parseAdvisoriesList.mitigation }}",
              "auto": "always"
            }
          }
        }
      }
    },
    "refreshBomChain": {
      "description": "POST BOMValidation/refreshBom to trigger re-import for this BOM",
      "root": "setRefreshing",
      "actions": {
        "setRefreshing": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isRefreshing": {
              "source": true
            }
          },
          "outcomes": {
            "success": "callRefreshBom"
          }
        },
        "callRefreshBom": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/refreshBom",
            "uriParams": {
              "bom_id": "{{ $page.variables.bomId }}"
            }
          },
          "outcomes": {
            "success": "notifyRefreshSuccess",
            "failure": "notifyRefreshError"
          }
        },
        "notifyRefreshSuccess": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "BOM refresh triggered successfully. Data will update shortly.",
            "type": "confirmation",
            "displayMode": "transient"
          },
          "outcomes": {
            "success": "clearRefreshing"
          }
        },
        "notifyRefreshError": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Refresh failed. Please try again.",
            "type": "error",
            "displayMode": "persist"
          },
          "outcomes": {
            "success": "clearRefreshing"
          }
        },
        "clearRefreshing": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isRefreshing": {
              "source": false
            }
          }
        }
      }
    },
    "requestBomAdvisoryChain": {
      "description": "Call OIC directly, wait for response, and display it",
      "root": "setAdvisoryLoading",
      "actions": {
        "setAdvisoryLoading": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "GENERATING"
            },
            "$page.variables.advisoryText": {
              "source": "Generating AI advisory... This may take a moment."
            },
            "$page.variables.advisoryMitigation": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "callOICIntegration"
          }
        },
        "callOICIntegration": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "OICAdvisoryService/postGenerateAdvisory",
            "body": {
              "bom_id": "{{ String($page.variables.bomId) }}",
              "requested_by": "VBCS_USER"
            }
          },
          "outcomes": {
            "success": "parseOICResult",
            "failure": "advisoryError"
          }
        },
        "parseOICResult": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseOICResponse",
            "params": [
              "{{ $chain.results.callOICIntegration.body }}"
            ]
          },
          "outcomes": {
            "success": "assignOICResult"
          }
        },
        "assignOICResult": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "{{ $chain.results.parseOICResult.status }}",
              "auto": "always"
            },
            "$page.variables.advisoryText": {
              "source": "{{ $chain.results.parseOICResult.context }}",
              "auto": "always"
            },
            "$page.variables.advisoryMitigation": {
              "source": "{{ $chain.results.parseOICResult.mitigation }}",
              "auto": "always"
            }
          }
        },
        "advisoryError": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "ERROR"
            },
            "$page.variables.advisoryText": {
              "source": "AI Advisory generation failed or timed out. Please check OIC integration logs."
            }
          }
        }
      }
    },
    "requestFindingAdvisoryChain": {
      "description": "Call FindingAdvisoryService (OIC) for the selected finding in Findings tab",
      "root": "setFindingAdvisoryLoading",
      "actions": {
        "setFindingAdvisoryLoading": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.findingAdvisoryStatus": {
              "source": "GENERATING"
            },
            "$page.variables.findingAdvisoryText": {
              "source": "Generating AI advisory… This may take a moment."
            },
            "$page.variables.findingAdvisoryMitigation": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "callOICIntegration"
          }
        },
        "callOICIntegration": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "FindingAdvisoryService/getFindingAdvisory",
            "queryParams": {
              "finding_id": "{{ String($page.variables.selectedFindingId) }}"
            }
          },
          "outcomes": {
            "success": "parseOICResult",
            "failure": "advisoryError"
          }
        },
        "parseOICResult": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseFindingAdvisoryResponse",
            "params": [
              "{{ $chain.results.callOICIntegration.body }}"
            ]
          },
          "outcomes": {
            "success": "assignOICResult"
          }
        },
        "assignOICResult": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.findingAdvisoryStatus": {
              "source": "{{ $chain.results.parseOICResult.status }}",
              "auto": "always"
            },
            "$page.variables.findingAdvisoryText": {
              "source": "{{ $chain.results.parseOICResult.context }}",
              "auto": "always"
            },
            "$page.variables.findingAdvisoryMitigation": {
              "source": "{{ $chain.results.parseOICResult.mitigation }}",
              "auto": "always"
            }
          }
        },
        "advisoryError": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.findingAdvisoryStatus": {
              "source": "ERROR"
            },
            "$page.variables.findingAdvisoryText": {
              "source": "AI Advisory generation failed or timed out. Please check OIC integration logs."
            }
          }
        }
      }
    },
    "selectFindingChain": {
      "variables": {
        "findingId": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignFindingId",
      "actions": {
        "assignFindingId": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.selectedFindingId": {
              "source": "{{ $chain.variables.findingId }}"
            }
          },
          "outcomes": {
            "success": "fetchExistingFindingAdvisory"
          }
        },
        "fetchExistingFindingAdvisory": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/getFindingAdvisories",
            "uriParams": {
              "finding_id": "{{ $page.variables.selectedFindingId }}"
            }
          },
          "outcomes": {
            "success": "parseExistingFindingAdvisory",
            "failure": "resetFindingAdvisory"
          }
        },
        "parseExistingFindingAdvisory": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseLatestFindingAdvisory",
            "params": [
              "{{ $chain.results.fetchExistingFindingAdvisory.body }}"
            ]
          },
          "outcomes": {
            "success": "assignFindingAdvisory"
          }
        },
        "assignFindingAdvisory": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.findingAdvisoryStatus": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.status }}",
              "auto": "always"
            },
            "$page.variables.findingAdvisoryText": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.context }}",
              "auto": "always"
            },
            "$page.variables.findingAdvisoryMitigation": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.mitigation }}",
              "auto": "always"
            }
          }
        },
        "resetFindingAdvisory": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.findingAdvisoryStatus": {
              "source": "NOT_REQUESTED"
            },
            "$page.variables.findingAdvisoryText": {
              "source": ""
            },
            "$page.variables.findingAdvisoryMitigation": {
              "source": ""
            }
          }
        }
      }
    },
    "ChangeTabChain": {
      "variables": {
        "tabName": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignVar",
      "actions": {
        "assignVar": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.selectedTab": {
              "source": "{{ $chain.variables.tabName }}"
            }
          }
        }
      }
    },
    "FilterStatusChangeChain": {
      "variables": {
        "value": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignStatus",
      "actions": {
        "assignStatus": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterStatus": {
              "source": "{{ $chain.variables.value }}"
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "FilterSeverityChangeChain": {
      "variables": {
        "value": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignSeverity",
      "actions": {
        "assignSeverity": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterSeverity": {
              "source": "{{ $chain.variables.value }}"
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "ClearFiltersChain": {
      "root": "resetFilters",
      "actions": {
        "resetFilters": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterStatus": {
              "source": ""
            },
            "$page.variables.filterSeverity": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "HandleItemsSourceChain": {
      "description": "Updates hasNoFindings flag based on API response item count",
      "root": "checkEmpty",
      "actions": {
        "checkEmpty": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "checkIfEmpty",
            "params": [
              "{{ $chain.variables.response }}"
            ]
          },
          "outcomes": {
            "success": "assignHasNoFindings"
          }
        },
        "assignHasNoFindings": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.hasNoFindings": {
              "source": "{{ $chain.results.checkEmpty }}"
            }
          }
        }
      },
      "variables": {
        "response": {
          "type": "any",
          "input": "fromCaller"
        }
      }
    },
    "runValidationChain": {
      "description": "POST to validation-runs and refresh all BOM data",
      "root": "setValidatingTrue",
      "actions": {
        "setValidatingTrue": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isValidating": {
              "source": true
            }
          },
          "outcomes": {
            "success": "callValidationAPI"
          }
        },
        "callValidationAPI": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/createValidationRun",
            "body": {
              "bom_id": "{{ Number($page.variables.bomId) }}",
              "requested_by": "VBCS User"
            }
          },
          "outcomes": {
            "success": "notifySuccess",
            "failure": "notifyError"
          }
        },
        "notifySuccess": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Validation run completed successfully.",
            "type": "confirmation",
            "displayMode": "transient"
          },
          "outcomes": {
            "success": "refreshBomData"
          }
        },
        "notifyError": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Validation run failed.",
            "message": "{{ $chain.results.callValidationAPI.error ? ('Error ' + $chain.results.callValidationAPI.error.status) : 'Missing/Invalid Endpoint ID in Service Connection' }}",
            "type": "error",
            "displayMode": "persist"
          },
          "outcomes": {
            "success": "setValidatingFalse"
          }
        },
        "refreshBomData": {
          "module": "vb/action/builtin/callChainAction",
          "parameters": {
            "id": "loadBomDetailChain",
            "params": {
              "bomId": "{{ $page.variables.bomId }}"
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          },
          "outcomes": {
            "success": "setValidatingFalse"
          }
        },
        "setValidatingFalse": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isValidating": {
              "source": false
            }
          }
        }
      }
    }
  },
  "eventListeners": {
    "buttonClick": {
      "chains": [
        {
          "chain": "buttonClickChain",
          "parameters": {
            "event": "{{$event}}"
          }
        }
      ]
    },
    "clickRunValidation": {
      "chains": [
        {
          "chainId": "runValidationChain"
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chainId": "LoadStylesChain"
        },
        {
          "chainId": "loadBomDetailChain"
        }
      ]
    },
    "clickOverview": { "chains": [ { "chainId": "ChangeTabChain", "parameters": { "tabName": "Overview" } } ] },
    "clickComponents": { "chains": [ { "chainId": "ChangeTabChain", "parameters": { "tabName": "Components" } } ] },
    "clickFindings": { "chains": [ { "chainId": "ChangeTabChain", "parameters": { "tabName": "Findings" } } ] },
    "clickScore": { "chains": [ { "chainId": "ChangeTabChain", "parameters": { "tabName": "Score" } } ] },
    "clickHistory": { "chains": [ { "chainId": "ChangeTabChain", "parameters": { "tabName": "History" } } ] },
    "clickRefresh": { "chains": [ { "chainId": "refreshBomChain" } ] },
    "clickRequestAdvisory": { "chains": [ { "chainId": "requestBomAdvisoryChain" } ] },
    "clickRequestFindingAdvisory": { "chains": [ { "chainId": "requestFindingAdvisoryChain" } ] },
    "clickFinding": {
      "chains": [
        {
          "chainId": "selectFindingChain",
          "parameters": {
            "findingId": "{{ $event.currentTarget.dataset.findingId }}"
          }
        }
      ]
    },
    "changeFilterStatus": {
      "chains": [
        {
          "chainId": "FilterStatusChangeChain",
          "parameters": {
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "changeFilterSeverity": {
      "chains": [
        {
          "chainId": "FilterSeverityChangeChain",
          "parameters": {
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "clickClearFilters": {
      "chains": [
        {
          "chainId": "ClearFiltersChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-if": { "path": "ojs/ojbindif" },
      "oj-bind-for-each": { "path": "ojs/ojbindforeach" },
      "oj-bind-text": { "path": "ojs/ojbindtext" },
      "oj-row-expander": {
        "path": "ojs/ojrowexpander"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      }
    }
  }
}