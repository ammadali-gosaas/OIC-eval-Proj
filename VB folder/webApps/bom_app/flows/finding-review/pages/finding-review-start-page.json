{
  "title": "Finding Review",
  "description": "Global finding review workflow — live data from BOMValidation API",
  "variables": {
    "selectedFindingId": {
      "type": "string"
    },
    "newStatus": {
      "type": "string",
      "defaultValue": "OPEN"
    },
    "statusComment": {
      "type": "string",
      "defaultValue": ""
    },
    "advisoryStatus": {
      "type": "string",
      "defaultValue": "NOT_REQUESTED"
    },
    "advisoryText": {
      "type": "string",
      "defaultValue": ""
    },
    "advisoryMitigation": {
      "type": "string",
      "defaultValue": ""
    },
    "advisoryRequestId": {
      "type": "string",
      "defaultValue": ""
    },
    "isSavingStatus": {
      "type": "boolean",
      "defaultValue": false
    },
    "filterStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "filterSeverity": {
      "type": "string",
      "defaultValue": ""
    },
    "hasNoFindings": {
      "type": "boolean",
      "defaultValue": false
    },
    "findingsSdp": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "BOMValidation/listFindings",
        "keyAttributes": "finding_id",
        "itemsPath": "items",
        "uriParameters": {
          "issue_status": "{{ $variables.filterStatus }}",
          "severity": "{{ $variables.filterSeverity }}"
        }
      },
      "events": {
        "onResponse": "HandleItemsSourceChain"
      }
    },
    "statusOptionsADP": {
      "type": "vb/ArrayDataProvider",
      "defaultValue": {
        "data": [
          { "value": "OPEN", "label": "Open" },
          { "value": "REVIEWED", "label": "Reviewed" },
          { "value": "IGNORED", "label": "Ignored" }
        ],
        "itemType": "statusOption",
        "keyAttributes": "value"
      }
    }
  },
  "metadata": {},
  "types": {
    "statusOption": {
      "value": "string",
      "label": "string"
    }
  },
  "chains": {
    "LoadStylesChain": {
      "root": "callFunctionLoadTailwind",
      "actions": {
        "callFunctionLoadTailwind": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "loadTailwind"
          }
        }
      }
    },
    "HandleItemsSourceChain": {
      "description": "Updates hasNoFindings flag based on API response item count",
      "root": "checkEmpty",
      "actions": {
        "checkEmpty": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "checkIfEmpty",
            "params": [
              "{{ $chain.variables.response }}"
            ]
          },
          "outcomes": {
            "success": "assignHasNoFindings"
          }
        },
        "assignHasNoFindings": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.hasNoFindings": {
              "source": "{{ $chain.results.checkEmpty }}"
            }
          }
        }
      },
      "variables": {
        "response": {
          "type": "any",
          "input": "fromCaller"
        }
      }
    },
    "FilterStatusChangeChain": {
      "variables": {
        "value": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignStatus",
      "actions": {
        "assignStatus": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterStatus": {
              "source": "{{ $chain.variables.value }}"
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "FilterSeverityChangeChain": {
      "variables": {
        "value": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignSeverity",
      "actions": {
        "assignSeverity": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterSeverity": {
              "source": "{{ $chain.variables.value }}"
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "ClearFiltersChain": {
      "description": "Resets filter variables and refreshes findings list",
      "root": "resetFilters",
      "actions": {
        "resetFilters": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.filterStatus": {
              "source": ""
            },
            "$page.variables.filterSeverity": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "refreshSdp"
          }
        },
        "refreshSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          }
        }
      }
    },
    "SelectFindingChain": {
      "variables": {
        "findingId": {
          "type": "string",
          "input": "fromCaller"
        },
        "currentStatus": {
          "type": "string",
          "input": "fromCaller"
        }
      },
      "root": "assignFindingId",
      "actions": {
        "assignFindingId": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.selectedFindingId": {
              "source": "{{ $chain.variables.findingId }}"
            },
            "$page.variables.newStatus": {
              "source": "{{ ($chain.variables.currentStatus || 'OPEN').toString().trim().toUpperCase() }}"
            },
            "$page.variables.statusComment": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "fetchExistingFindingAdvisory"
          }
        },
        "fetchExistingFindingAdvisory": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/getFindingAdvisories",
            "uriParams": {
              "finding_id": "{{ $page.variables.selectedFindingId }}"
            }
          },
          "outcomes": {
            "success": "parseExistingFindingAdvisory",
            "failure": "resetFindingAdvisory"
          }
        },
        "parseExistingFindingAdvisory": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseLatestFindingAdvisory",
            "params": [
              "{{ $chain.results.fetchExistingFindingAdvisory.body }}"
            ]
          },
          "outcomes": {
            "success": "assignFindingAdvisory"
          }
        },
        "assignFindingAdvisory": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.status }}",
              "auto": "always"
            },
            "$page.variables.advisoryText": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.context }}",
              "auto": "always"
            },
            "$page.variables.advisoryMitigation": {
              "source": "{{ $chain.results.parseExistingFindingAdvisory.mitigation }}",
              "auto": "always"
            }
          }
        },
        "resetFindingAdvisory": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "NOT_REQUESTED"
            },
            "$page.variables.advisoryText": {
              "source": ""
            },
            "$page.variables.advisoryMitigation": {
              "source": ""
            }
          }
        }
      }
    },
    "UpdateStatusChain": {
      "description": "PATCH BOMValidation/updateFindingStatus with new status and optional comment",
      "root": "setSaving",
      "actions": {
        "setSaving": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isSavingStatus": {
              "source": true
            }
          },
          "outcomes": {
            "success": "callUpdateStatus"
          }
        },
        "callUpdateStatus": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/updateFindingStatus",
            "uriParams": {
              "finding_id": "{{ $page.variables.selectedFindingId }}"
            },
            "body": {
              "status": "{{ $page.variables.newStatus }}",
              "comment": "{{ $page.variables.statusComment }}"
            }
          },
          "outcomes": {
            "success": "notifySuccess",
            "failure": "notifyError"
          }
        },
        "notifySuccess": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Finding status updated successfully.",
            "type": "confirmation",
            "displayMode": "transient"
          },
          "outcomes": {
            "success": "refreshFindingsSdp"
          }
        },
        "refreshFindingsSdp": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": {
            "target": "[[ $page.variables.findingsSdp ]]",
            "refresh": null
          },
          "outcomes": {
            "success": "clearSaving"
          }
        },
        "notifyError": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "target": "leaf",
            "summary": "Failed to update status. Please try again.",
            "type": "error",
            "displayMode": "persist"
          },
          "outcomes": {
            "success": "clearSaving"
          }
        },
        "clearSaving": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isSavingStatus": {
              "source": false
            }
          }
        }
      }
    },
    "RequestAdvisoryChain": {
      "description": "Call FindingAdvisoryService (OIC) directly for the selected finding, wait for the response, and display it",
      "root": "setAdvisoryLoading",
      "actions": {
        "setAdvisoryLoading": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "GENERATING"
            },
            "$page.variables.advisoryText": {
              "source": "Generating AI advisory… This may take a moment."
            },
            "$page.variables.advisoryMitigation": {
              "source": ""
            }
          },
          "outcomes": {
            "success": "callOICIntegration"
          }
        },
        "callOICIntegration": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "FindingAdvisoryService/getFindingAdvisory",
            "queryParams": {
              "finding_id": "{{ String($page.variables.selectedFindingId) }}"
            }
          },
          "outcomes": {
            "success": "parseOICResult",
            "failure": "advisoryError"
          }
        },
        "parseOICResult": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseFindingAdvisoryResponse",
            "params": [
              "{{ $chain.results.callOICIntegration.body }}"
            ]
          },
          "outcomes": {
            "success": "assignOICResult"
          }
        },
        "assignOICResult": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "{{ $chain.results.parseOICResult.status }}",
              "auto": "always"
            },
            "$page.variables.advisoryText": {
              "source": "{{ $chain.results.parseOICResult.context }}",
              "auto": "always"
            },
            "$page.variables.advisoryMitigation": {
              "source": "{{ $chain.results.parseOICResult.mitigation }}",
              "auto": "always"
            }
          }
        },
        "advisoryError": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.advisoryStatus": {
              "source": "ERROR"
            },
            "$page.variables.advisoryText": {
              "source": "AI Advisory generation failed or timed out. Please check OIC integration logs."
            }
          }
        }
      }
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chainId": "LoadStylesChain"
        }
      ]
    },
    "changeFilterStatus": {
      "chains": [
        {
          "chainId": "FilterStatusChangeChain",
          "parameters": {
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "changeFilterSeverity": {
      "chains": [
        {
          "chainId": "FilterSeverityChangeChain",
          "parameters": {
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "clickClearFilters": {
      "chains": [
        {
          "chainId": "ClearFiltersChain"
        }
      ]
    },
    "clickFinding": {
      "chains": [
        {
          "chainId": "SelectFindingChain",
          "parameters": {
            "findingId": "{{ $event.currentTarget.dataset.findingId }}",
            "currentStatus": "{{ $event.currentTarget.dataset.currentStatus }}"
          }
        }
      ]
    },
    "clickSaveStatus": {
      "chains": [
        {
          "chainId": "UpdateStatusChain"
        }
      ]
    },
    "clickRequestAdvisory": {
      "chains": [
        {
          "chainId": "RequestAdvisoryChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-text": {
        "path": "ojs/ojbindtext"
      },
      "oj-bind-for-each": {
        "path": "ojs/ojbindforeach"
      },
      "oj-bind-if": {
        "path": "ojs/ojbindif"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      }
    }
  }
}