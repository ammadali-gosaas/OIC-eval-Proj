{
  "title": "Validation Rules",
  "description": "Readable active rule metadata and thresholds",
  "variables": {
    "rulesSdp": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "BOMValidation/listRules",
        "keyAttributes": "rule_code",
        "itemsPath": "items"
      }
    },
    "activeScheduleInfo": { "type": "string", "defaultValue": "Checking active database schedule..." },
    "isAddRuleModalOpen": { "type": "boolean", "defaultValue": false },
    "isScheduleModalOpen": { "type": "boolean", "defaultValue": false },
    "isEditRuleModalOpen": { "type": "boolean", "defaultValue": false },
    "isDeleteRuleModalOpen": { "type": "boolean", "defaultValue": false },
    "newRuleCode": { "type": "string" },
    "newRuleName": { "type": "string" },
    "newRuleDescription": { "type": "string" },
    "newRuleSeverity": { "type": "string", "defaultValue": "CRITICAL" },
    "scheduleTime": { "type": "string", "defaultValue": "01:45" },
    "scheduleInterval": { "type": "string", "defaultValue": "DAILY" },
    "editRuleCode": { "type": "string" },
    "editRuleName": { "type": "string" },
    "editRuleDescription": { "type": "string" },
    "editRuleSeverity": { "type": "string" },
    "editRuleConfig": { "type": "string" },
    "editRuleEnabled": { "type": "string", "defaultValue": "Y" },
    "editConfigState": { "type": "any", "defaultValue": {} },
    "deleteRuleCode": { "type": "string" },
    "deleteRuleName": { "type": "string" }
  },
  "metadata": {},
  "types": {},
  "chains": {
    "LoadStylesChain": {
      "root": "callFunctionLoadTailwind",
      "actions": {
        "callFunctionLoadTailwind": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": { "module": "[[ $functions ]]", "functionName": "loadTailwind" }
        }
      }
    },
    "UpdateEditNameChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": {
        "assignVal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": { "$page.variables.editRuleName": { "source": "{{ $chain.variables.val }}" } }
        }
      }
    },
    "UpdateEditDescChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": {
        "assignVal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": { "$page.variables.editRuleDescription": { "source": "{{ $chain.variables.val }}" } }
        }
      }
    },
    "UpdateEditSeverityChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": {
        "assignVal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": { "$page.variables.editRuleSeverity": { "source": "{{ $chain.variables.val }}" } }
        }
      }
    },
    "UpdateEditEnabledChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": {
        "assignVal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": { "$page.variables.editRuleEnabled": { "source": "{{ $chain.variables.val }}" } }
        }
      }
    },
    "UpdateConfigParamChain": {
      "variables": {
        "param": { "type": "string", "input": "fromCaller" },
        "val": { "type": "any", "input": "fromCaller" },
        "isCheckbox": { "type": "string", "input": "fromCaller" }
      },
      "root": "callUpdateConfigJS",
      "actions": {
        "callUpdateConfigJS": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "updateConfigState",
            "params": [
              "{{ $page.variables.editConfigState }}",
              "{{ $chain.variables.param }}",
              "{{ $chain.variables.val }}",
              "{{ $chain.variables.isCheckbox }}"
            ]
          },
          "outcomes": { "success": "assignState" }
        },
        "assignState": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.editConfigState": { "source": "{{ $chain.results.callUpdateConfigJS }}" }
          }
        }
      }
    },
    "UpdateNewCodeChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": { "assignVal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.newRuleCode": { "source": "{{ $chain.variables.val }}" } } } }
    },
    "UpdateNewNameChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": { "assignVal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.newRuleName": { "source": "{{ $chain.variables.val }}" } } } }
    },
    "UpdateNewDescChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": { "assignVal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.newRuleDescription": { "source": "{{ $chain.variables.val }}" } } } }
    },
    "UpdateNewSeverityChain": {
      "variables": { "val": { "type": "string", "input": "fromCaller" } },
      "root": "assignVal",
      "actions": { "assignVal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.newRuleSeverity": { "source": "{{ $chain.variables.val }}" } } } }
    },
    "UpdateScheduleTimeChain": {
      "variables": { "timeVal": { "type": "string", "input": "fromCaller" } },
      "root": "assignTime",
      "actions": { "assignTime": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.scheduleTime": { "source": "{{ $chain.variables.timeVal }}" } } } }
    },
    "UpdateScheduleIntervalChain": {
      "variables": { "intervalVal": { "type": "string", "input": "fromCaller" } },
      "root": "assignInterval",
      "actions": { "assignInterval": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.scheduleInterval": { "source": "{{ $chain.variables.intervalVal }}" } } } }
    },
    "OpenScheduleModalChain": {
      "root": "fetchActiveSchedule",
      "actions": {
        "fetchActiveSchedule": {
          "module": "vb/action/builtin/restAction",
          "parameters": { "endpoint": "BOMValidation/getSchedules" },
          "outcomes": { "success": "parseScheduleResponse", "failure": "setNoScheduleText" }
        },
        "parseScheduleResponse": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "formatScheduleInfo",
            "params": [ "{{ $chain.results.fetchActiveSchedule.body.items[0] }}" ]
          },
          "outcomes": { "success": "assignScheduleText" }
        },
        "assignScheduleText": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.activeScheduleInfo": { "source": "{{ $chain.results.parseScheduleResponse }}" },
            "$page.variables.isScheduleModalOpen": { "source": true }
          }
        },
        "setNoScheduleText": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.activeScheduleInfo": { "source": "No active background schedule configured." },
            "$page.variables.isScheduleModalOpen": { "source": true }
          }
        }
      }
    },
    "OpenAddRuleModalChain": {
      "root": "openModal",
      "actions": {
        "openModal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isAddRuleModalOpen": { "source": true },
            "$page.variables.newRuleCode": { "source": "" },
            "$page.variables.newRuleName": { "source": "" },
            "$page.variables.newRuleDescription": { "source": "" },
            "$page.variables.newRuleSeverity": { "source": "CRITICAL" }
          }
        }
      }
    },
    "CloseAddRuleModalChain": {
      "root": "closeModal",
      "actions": { "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isAddRuleModalOpen": { "source": false } } } }
    },
    "SubmitAddRuleChain": {
      "root": "callCreateRuleApi",
      "actions": {
        "callCreateRuleApi": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/createRule",
            "body": {
              "rule_code": "{{ $page.variables.newRuleCode }}",
              "rule_name": "{{ $page.variables.newRuleName }}",
              "description": "{{ $page.variables.newRuleDescription }}",
              "severity": "{{ $page.variables.newRuleSeverity }}",
              "rule_config": "{}"
            }
          },
          "outcomes": { "success": "refreshRulesList", "failure": "fireErrorNotification" }
        },
        "refreshRulesList": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": { "target": "{{ $page.variables.rulesSdp }}", "refresh": null },
          "outcomes": { "success": "closeModal" }
        },
        "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isAddRuleModalOpen": { "source": false } } },
        "fireErrorNotification": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": { "summary": "Save Failed", "message": "The Add Rule request failed.", "type": "error" }
        }
      }
    },
    "CloseScheduleModalChain": {
      "root": "closeModal",
      "actions": { "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isScheduleModalOpen": { "source": false } } } }
    },
    "SubmitScheduleChain": {
      "root": "callCreateScheduleApi",
      "actions": {
        "callCreateScheduleApi": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/createSchedule",
            "body": {
              "time": "{{ $page.variables.scheduleTime }}",
              "interval": "{{ $page.variables.scheduleInterval }}"
            }
          },
          "outcomes": { "success": "notifySuccess", "failure": "fireErrorNotification" }
        },
        "notifySuccess": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": {
            "summary": "Schedule Created Successfully",
            "message": "{{ 'Validation job scheduled to run ' + $page.variables.scheduleInterval + ' at ' + $page.variables.scheduleTime + ' (GMT+5).' }}",
            "type": "confirmation",
            "displayMode": "transient"
          },
          "outcomes": { "success": "closeModal" }
        },
        "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isScheduleModalOpen": { "source": false } } },
        "fireErrorNotification": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": { "summary": "Schedule Failed", "message": "The Schedule request failed.", "type": "error" }
        }
      }
    },
    "OpenEditRuleModalChain": {
      "variables": {
        "ruleCode": { "type": "string", "input": "fromCaller" },
        "ruleName": { "type": "string", "input": "fromCaller" },
        "description": { "type": "string", "input": "fromCaller" },
        "severity": { "type": "string", "input": "fromCaller" },
        "config": { "type": "string", "input": "fromCaller" },
        "enabledFlag": { "type": "string", "input": "fromCaller" }
      },
      "root": "parseConfigJS",
      "actions": {
        "parseConfigJS": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "parseRuleConfig",
            "params": [
              "{{ $chain.variables.ruleCode }}",
              "{{ $chain.variables.config }}"
            ]
          },
          "outcomes": { "success": "openModal" }
        },
        "openModal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isEditRuleModalOpen": { "source": true },
            "$page.variables.editRuleCode": { "source": "{{ $chain.variables.ruleCode }}" },
            "$page.variables.editRuleName": { "source": "{{ $chain.variables.ruleName }}" },
            "$page.variables.editRuleDescription": { "source": "{{ $chain.variables.description }}" },
            "$page.variables.editRuleSeverity": { "source": "{{ $chain.variables.severity }}" },
            "$page.variables.editRuleConfig": { "source": "{{ $chain.variables.config }}" },
            "$page.variables.editRuleEnabled": { "source": "{{ $chain.variables.enabledFlag }}" },
            "$page.variables.editConfigState": { "source": "{{ $chain.results.parseConfigJS }}" }
          }
        }
      }
    },
    "CloseEditRuleModalChain": {
      "root": "closeModal",
      "actions": { "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isEditRuleModalOpen": { "source": false } } } }
    },
    "SubmitEditRuleChain": {
      "root": "buildConfigJS",
      "actions": {
        "buildConfigJS": {
          "module": "vb/action/builtin/callModuleFunctionAction",
          "parameters": {
            "module": "[[ $functions ]]",
            "functionName": "buildRuleConfig",
            "params": [
              "{{ $page.variables.editRuleCode }}",
              "{{ $page.variables.editConfigState }}"
            ]
          },
          "outcomes": { "success": "callUpdateRuleApi" }
        },
        "callUpdateRuleApi": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/updateRule",
            "uriParams": { "rule_id": "{{ $page.variables.editRuleCode }}" },
            "body": {
              "rule_name": "{{ $page.variables.editRuleName }}",
              "description": "{{ $page.variables.editRuleDescription }}",
              "severity": "{{ $page.variables.editRuleSeverity }}",
              "rule_config": "{{ $chain.results.buildConfigJS }}",
              "enabled_flag": "{{ $page.variables.editRuleEnabled }}"
            }
          },
          "outcomes": { "success": "refreshRulesList", "failure": "fireErrorNotification" }
        },
        "refreshRulesList": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": { "target": "{{ $page.variables.rulesSdp }}", "refresh": null },
          "outcomes": { "success": "closeModal" }
        },
        "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isEditRuleModalOpen": { "source": false } } },
        "fireErrorNotification": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": { "summary": "Update Failed", "message": "The Edit request failed.", "type": "error" }
        }
      }
    },
    "OpenDeleteRuleModalChain": {
      "variables": {
        "ruleCode": { "type": "string", "input": "fromCaller" },
        "ruleName": { "type": "string", "input": "fromCaller" }
      },
      "root": "openModal",
      "actions": {
        "openModal": {
          "module": "vb/action/builtin/assignVariablesAction",
          "parameters": {
            "$page.variables.isDeleteRuleModalOpen": { "source": true },
            "$page.variables.deleteRuleCode": { "source": "{{ $chain.variables.ruleCode }}" },
            "$page.variables.deleteRuleName": { "source": "{{ $chain.variables.ruleName }}" }
          }
        }
      }
    },
    "CloseDeleteRuleModalChain": {
      "root": "closeModal",
      "actions": { "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isDeleteRuleModalOpen": { "source": false } } } }
    },
    "SubmitDeleteRuleChain": {
      "root": "callDeleteRuleApi",
      "actions": {
        "callDeleteRuleApi": {
          "module": "vb/action/builtin/restAction",
          "parameters": {
            "endpoint": "BOMValidation/deleteRule",
            "uriParams": { "rule_code": "{{ $page.variables.deleteRuleCode }}" }
          },
          "outcomes": { "success": "refreshRulesList", "failure": "fireErrorNotification" }
        },
        "refreshRulesList": {
          "module": "vb/action/builtin/fireDataProviderEventAction",
          "parameters": { "target": "{{ $page.variables.rulesSdp }}", "refresh": null },
          "outcomes": { "success": "closeModal" }
        },
        "closeModal": { "module": "vb/action/builtin/assignVariablesAction", "parameters": { "$page.variables.isDeleteRuleModalOpen": { "source": false } } },
        "fireErrorNotification": {
          "module": "vb/action/builtin/fireNotificationEventAction",
          "parameters": { "summary": "Delete Failed", "message": "The Delete Rule request failed.", "type": "error" }
        }
      }
    }
  },
  "eventListeners": {
    "vbEnter": { "chains": [ { "chainId": "LoadStylesChain" } ] },
    "clickOpenAddRule": { "chains": [ { "chainId": "OpenAddRuleModalChain" } ] },
    "clickCloseAddRule": { "chains": [ { "chainId": "CloseAddRuleModalChain" } ] },
    "clickSubmitAddRule": { "chains": [ { "chainId": "SubmitAddRuleChain" } ] },
    "clickOpenSchedule": { "chains": [ { "chainId": "OpenScheduleModalChain" } ] },
    "clickCloseSchedule": { "chains": [ { "chainId": "CloseScheduleModalChain" } ] },
    "clickSubmitSchedule": { "chains": [ { "chainId": "SubmitScheduleChain" } ] },
    "clickOpenEditRule": { 
      "chains": [ 
        { 
          "chainId": "OpenEditRuleModalChain", 
          "parameters": { 
            "ruleCode": "{{ $event.currentTarget.dataset.ruleCode }}",
            "ruleName": "{{ $event.currentTarget.dataset.ruleName }}",
            "description": "{{ $event.currentTarget.dataset.description }}",
            "severity": "{{ $event.currentTarget.dataset.severity }}",
            "config": "{{ $event.currentTarget.dataset.config }}",
            "enabledFlag": "{{ $event.currentTarget.dataset.enabled }}"
          } 
        } 
      ] 
    },
    "clickCloseEditRule": { "chains": [ { "chainId": "CloseEditRuleModalChain" } ] },
    "clickSubmitEditRule": { "chains": [ { "chainId": "SubmitEditRuleChain" } ] },
    "clickOpenDeleteRule": {
      "chains": [
        {
          "chainId": "OpenDeleteRuleModalChain",
          "parameters": {
            "ruleCode": "{{ $event.currentTarget.dataset.ruleCode }}",
            "ruleName": "{{ $event.currentTarget.dataset.ruleName }}"
          }
        }
      ]
    },
    "clickCloseDeleteRule": { "chains": [ { "chainId": "CloseDeleteRuleModalChain" } ] },
    "clickSubmitDeleteRule": { "chains": [ { "chainId": "SubmitDeleteRuleChain" } ] },
    "changeScheduleTime": {
      "chains": [ { "chainId": "UpdateScheduleTimeChain", "parameters": { "timeVal": "{{ $event.target.value }}" } } ]
    },
    "changeScheduleInterval": {
      "chains": [ { "chainId": "UpdateScheduleIntervalChain", "parameters": { "intervalVal": "{{ $event.target.value }}" } } ]
    },
    "changeEditRuleName": {
      "chains": [ { "chainId": "UpdateEditNameChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeEditRuleDescription": {
      "chains": [ { "chainId": "UpdateEditDescChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeEditRuleSeverity": {
      "chains": [ { "chainId": "UpdateEditSeverityChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeEditRuleEnabled": {
      "chains": [ { "chainId": "UpdateEditEnabledChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeConfigParam": {
      "chains": [
        {
          "chainId": "UpdateConfigParamChain",
          "parameters": {
            "param": "{{ $event.target.dataset.param }}",
            "val": "{{ $event.target.dataset.type === 'checkbox' ? $event.target.checked : $event.target.value }}",
            "isCheckbox": "{{ $event.target.dataset.type }}"
          }
        }
      ]
    },
    "changeNewRuleCode": {
      "chains": [ { "chainId": "UpdateNewCodeChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeNewRuleName": {
      "chains": [ { "chainId": "UpdateNewNameChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeNewRuleDescription": {
      "chains": [ { "chainId": "UpdateNewDescChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    },
    "changeNewRuleSeverity": {
      "chains": [ { "chainId": "UpdateNewSeverityChain", "parameters": { "val": "{{ $event.target.value }}" } } ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-text": { "path": "ojs/ojbindtext" },
      "oj-bind-for-each": { "path": "ojs/ojbindforeach" },
      "oj-bind-if": { "path": "ojs/ojbindif" }
    }
  }
}